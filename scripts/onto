#!/usr/bin/env sh
# Lanceur de la CLI `onto` utilisable sans installation (hooks Claude Code / Cursor, serveur MCP).
# Installe rdflib + pyshacl à la première exécution si nécessaire (environnements éphémères).
ROOT="${CLAUDE_PROJECT_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
cd "$ROOT" || exit 0
if [ ! -f .ontorepo/deps-ok ]; then
  if ! python3 -c "import rdflib, pyshacl" >/dev/null 2>&1; then
    python3 -m pip install -q "rdflib>=7.0" "pyshacl>=0.26" >/dev/null 2>&1 || true
  fi
  python3 -c "import rdflib, pyshacl" >/dev/null 2>&1 && mkdir -p .ontorepo && touch .ontorepo/deps-ok
fi
PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m ontorepo "$@"
