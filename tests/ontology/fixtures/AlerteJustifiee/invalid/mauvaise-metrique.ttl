# Seuil disque appliqué à une température.
@prefix d:     <https://adrien2112.github.io/data/> .
@prefix orga:  <https://adrien2112.github.io/ontology/organisation#> .
@prefix fleet: <https://adrien2112.github.io/ontology/parc#> .
@prefix mon:   <https://adrien2112.github.io/ontology/supervision#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

d:site-a a orga:Site ; orga:nom "Blanchisserie A" ; orga:typeDeSite orga:Blanchisserie .
d:pc-1 a fleet:PosteFixe ; fleet:numeroSerie "PF-000001" ; fleet:installeSur d:site-a .
d:obs-1 a mon:Observation ; mon:surEquipement d:pc-1 ; mon:metrique mon:TemperatureCPU ; mon:valeur "95"^^xsd:decimal ; mon:horodatage "2026-10-01T08:00:00Z"^^xsd:dateTime .
d:seuil-1 a mon:Seuil ; mon:pourMetrique mon:UtilisationDisque ; mon:pourTypeDeSite orga:Blanchisserie ; mon:valeurMax "90"^^xsd:decimal .
d:alerte-1 a mon:Alerte ; mon:declencheePar d:obs-1 ; mon:selonSeuil d:seuil-1 .
