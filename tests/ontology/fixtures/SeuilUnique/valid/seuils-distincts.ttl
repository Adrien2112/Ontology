# Deux seuils, deux types de site.
@prefix d:     <https://adrien2112.github.io/data/> .
@prefix orga:  <https://adrien2112.github.io/ontology/organisation#> .
@prefix fleet: <https://adrien2112.github.io/ontology/parc#> .
@prefix mon:   <https://adrien2112.github.io/ontology/supervision#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

d:seuil-1 a mon:Seuil ; mon:pourMetrique mon:TemperatureCPU ; mon:pourTypeDeSite orga:Blanchisserie ; mon:valeurMax "90"^^xsd:decimal .
d:seuil-2 a mon:Seuil ; mon:pourMetrique mon:TemperatureCPU ; mon:pourTypeDeSite orga:Siege ; mon:valeurMax "75"^^xsd:decimal .
